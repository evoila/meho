{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "MEHO built-in Keycloak subchart values",
  "description": "Values of the built-in Keycloak (`coreKeycloak` in the parent chart). Helm checks them only when the subchart is on (`coreKeycloak.enabled: true`).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object",
      "description": "Helm's shared values. The subchart reads `global.openshift`."
    },
    "hostname": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$",
      "description": "MEHO's public DNS name (the same value as `ingress.host`). Keycloak's public address is `https://<hostname>/auth`. Required when the subchart is on."
    },
    "firstTenantId": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
      "description": "The first tenant's id, a UUID. The bootstrap Job gives every group in `groups` this id as the `tenant_id` attribute. Required when the subchart is on."
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "description": "The realm's role groups, in one list. The bootstrap Job creates each missing group with the attributes `tenant_id` (= `firstTenantId`), `tenant_role` and, when `approver` is true, `approver`. It never changes a group that exists. A person should be in exactly one of these groups.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tenantRole"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$"
          },
          "tenantRole": {
            "type": "string",
            "enum": [
              "read_only",
              "operator",
              "tenant_admin"
            ]
          },
          "approver": {
            "type": "boolean"
          }
        }
      }
    },
    "firstLogin": {
      "type": "object",
      "additionalProperties": false,
      "description": "The two people the bootstrap Job creates at the first install, with temporary passwords in `<release>-core-first-login`. The first admin also gets the realm role `platform_admin`.",
      "properties": {
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "username",
            "group"
          ],
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "group": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$",
              "description": "One of the names in `groups`."
            }
          }
        },
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "username",
            "group"
          ],
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "group": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$",
              "description": "One of the names in `groups`."
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "Manifest digest (`sha256:<64 hex>`). Wins over `tag` when set. Empty = deploy by tag."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "waitForDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$",
              "description": "Manifest digest (`sha256:<64 hex>`). Wins over `tag` when set. Empty = deploy by tag."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                },
                "ephemeral-storage": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                }
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                },
                "ephemeral-storage": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                }
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "PostgreSQL host. Empty = `<release>-postgres`."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "existingSecrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Your own Secret for Keycloak's first-start service account. Empty = the Secret the install's secrets Job creates.",
      "properties": {
        "bootstrap": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposeAdmin": {
          "type": "boolean",
          "description": "Also route `/auth/admin` and `/auth/realms/master` (the admin console) on the MEHO host."
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            },
            "ephemeral-storage": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            }
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            },
            "ephemeral-storage": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backplanePodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "More allowed peers, as NetworkPolicy `from` entries."
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  }
}
