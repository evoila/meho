{
  "id": "/ui/",
  "name": "MEHO",
  "short_name": "MEHO",
  "description": "Approve requests and follow the broadcast feed of your MEHO.",
  "start_url": "/ui/approvals",
  "scope": "/ui/",
  "display": "standalone",
  "background_color": "#101316",
  "theme_color": "#101316",
  "icons": [
    {
      "src": "/ui/static/src/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/ui/static/src/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/ui/static/src/brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/ui/static/src/brand/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
