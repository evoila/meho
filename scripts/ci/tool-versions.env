# The pinned versions of the tools that CI jobs download.
# This is the one place for them. To bump a tool, change its version and
# its sha256 here. The cache key of each job is the hash of this file, so
# a bump makes the job download the new version once.
# The sha256 is the digest that the release publishes for the file.
KUBECONFORM_VER=v0.6.7
KUBECONFORM_SHA=95f14e87aa28c09d5941f11bd024c1d02fdc0303ccaa23f61cef67bc92619d73
KIND_VER=v0.33.0
KIND_SHA=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
GOLANGCI_LINT_VER=v2.12.2
GOLANGCI_LINT_SHA=8df580d2670fed8fa984aac0507099af8df275e665215f5c7a2ae3943893a553
# The en_core_web_sm language model of spaCy. Use a version that the spaCy
# in backend/uv.lock supports.
SPACY_MODEL_VER=3.8.0
SPACY_MODEL_SHA=1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85
# The Tailwind CLI that backend/Dockerfile runs in the image build. The
# Dockerfile has the same version and checksums as its defaults, so a build
# outside CI needs no extra step. stage_tailwind.sh stops when the two
# places differ.
TAILWIND_VER=v4.3.0
TAILWIND_SHA_AMD64=73f0e5459054e5cfaa8ab6f3b940f3fbe0f13cc7fd83bc24e7c655033c203400
TAILWIND_SHA_ARM64=8f48dcb72be3b351c10563c5329b4638ba8516820dc3b3a1609625a166e87cbd
