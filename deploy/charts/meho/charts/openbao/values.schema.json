{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "MEHO built-in OpenBao subchart values",
  "description": "Values of the built-in OpenBao (`coreVault` in the parent chart). Helm checks them only when the subchart is on (`coreVault.enabled: true`).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object",
      "description": "Helm's shared values. The subchart reads `global.openshift`, `global.imageRegistry` and `global.imagePullSecrets`."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "Manifest digest (`sha256:<64 hex>`). Wins over `tag` when set. Empty = deploy by tag."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "binary": {
      "type": "string",
      "enum": [
        "bao",
        "vault"
      ],
      "description": "The program in the image: `bao` for OpenBao, `vault` for a HashiCorp Vault image (tests only)."
    },
    "authDelegator": {
      "type": "boolean",
      "description": "Render a ClusterRoleBinding of OpenBao's service account to `system:auth-delegator`. The chart's only cluster-wide object. Default false."
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$",
          "description": "Data disk size. A StatefulSet cannot change it after the first install."
        },
        "storageClass": {
          "type": "string",
          "description": "Storage class of the data disk. Empty = the cluster default."
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            },
            "ephemeral-storage": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            }
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            },
            "ephemeral-storage": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backplanePodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "More allowed peers, as NetworkPolicy `from` entries."
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  }
}
