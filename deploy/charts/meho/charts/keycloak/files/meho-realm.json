{
  "realm": "meho",
  "displayName": "MEHO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 604800,
  "attributes": {
    "CreateDefaultClientScopes": "true"
  },
  "clientScopes": [
    {
      "name": "mcp:read",
      "description": "MEHO MCP working surface: list and read.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:execute",
      "description": "MEHO MCP working surface: run operations.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:admin",
      "description": "MEHO MCP operator tools. Only granted when the client asks for it.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "groups": [
    {
      "name": "MEHO-Readers",
      "attributes": {
        "tenant_id": [
          "${MEHO_REALM_TENANT_ID}"
        ],
        "tenant_role": [
          "read_only"
        ],
        "meho_tenant": [
          "${MEHO_REALM_TENANT_ID}:${MEHO_REALM_TENANT_NAME}:Readers"
        ]
      }
    },
    {
      "name": "MEHO-Operators",
      "attributes": {
        "tenant_id": [
          "${MEHO_REALM_TENANT_ID}"
        ],
        "tenant_role": [
