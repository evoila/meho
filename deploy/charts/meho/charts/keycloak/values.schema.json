{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "MEHO built-in Keycloak subchart values",
  "description": "Values of the built-in Keycloak (`coreKeycloak` in the parent chart). Helm checks them only when the subchart is on (`coreKeycloak.enabled: true`).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object",
      "description": "Helm's shared values. The subchart reads `global.openshift`, `global.imageRegistry` and `global.imagePullSecrets`."
    },
    "hostname": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$",
      "description": "MEHO's public DNS name (the same value as `ingress.host`). Keycloak's public address is `https://<hostname>/auth`. Required when the subchart is on."
    },
    "firstTenantId": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
      "description": "The first tenant's id, a UUID. Every realm group carries it as the `tenant_id` attribute. Required when the subchart is on."
    },
    "tenantName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "description": "The first tenant's short name (lowercase letters, digits and dashes). The five role groups carry it in the `meho_tenant` attribute."
    },
    "tenants": {
      "type": "array",
      "description": "More tenants. The parent chart's bootstrap Job makes the five groups `MEHO-<name>-<Role>` for each one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "Manifest digest (`sha256:<64 hex>`). Wins over `tag` when set. Empty = deploy by tag."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "waitForDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$",
              "description": "Manifest digest (`sha256:<64 hex>`). Wins over `tag` when set. Empty = deploy by tag."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                },
                "ephemeral-storage": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                }
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                },
                "ephemeral-storage": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
                }
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "PostgreSQL host. Empty = `<release>-postgres`."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "existingSecrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Your own Secret for Keycloak's first-start service account. Empty = the Secret the install's secrets Job creates.",
      "properties": {
        "bootstrap": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        }
      }
    },
    "firstLogin": {
      "type": "object",
      "additionalProperties": false,
      "description": "User names of the two people the bootstrap Job makes at the first start. The parent chart's Job reads them; the subchart only carries them.",
      "properties": {
        "adminUsername": {
          "type": "string",
          "minLength": 1
        },
        "approverUsername": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "description": "A login for automated install proofs, off by default. The parent chart's bootstrap Job reads it; the subchart only carries it.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposeAdmin": {
          "type": "boolean",
          "description": "Also route `/auth/admin` and `/auth/realms/master` (the admin console) on the MEHO host."
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            },
            "ephemeral-storage": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            }
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?m?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            },
            "ephemeral-storage": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backplanePodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "More allowed peers, as NetworkPolicy `from` entries."
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  }
}
